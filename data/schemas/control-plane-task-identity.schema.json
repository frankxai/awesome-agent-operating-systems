{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frankxai/awesome-agent-operating-systems/blob/main/data/schemas/control-plane-task-identity.schema.json",
  "title": "Starlight control-plane task identity",
  "description": "Stable identity and single-owner authority mapping across Hermes, GitHub, Starlight swarm, and an optional governance shell.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalTaskId",
    "title",
    "scope",
    "idempotencyKey",
    "createdAt",
    "authority",
    "scheduler",
    "systems",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "starlight.control-plane-task-identity.v1"
    },
    "canonicalTaskId": {
      "type": "string",
      "pattern": "^ctid:v1:[a-z0-9][a-z0-9-]{1,62}:[a-z0-9][a-z0-9-]{1,94}$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 180
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskState", "deliveryEvidence", "scheduler", "fleetRouting"],
      "properties": {
        "taskState": {"const": "hermes-kanban"},
        "deliveryEvidence": {"const": "git-github"},
        "scheduler": {"const": "hermes-cron"},
        "fleetRouting": {"const": "starlight-swarm"}
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "mode", "jobId", "script", "workdir", "duplicateDispatchPolicy"],
      "properties": {
        "owner": {"const": "hermes-cron"},
        "mode": {"const": "script-only"},
        "jobId": {
          "type": "string",
          "pattern": "^[a-f0-9]{12}$"
        },
        "script": {"const": "control-plane-upstream-promotion-gates.py"},
        "workdir": {"const": "."},
        "duplicateDispatchPolicy": {"const": "NOOP_DUPLICATE"}
      }
    },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hermes", "github", "swarm", "paperclip"],
      "properties": {
        "hermes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["board", "taskId", "workflowTaskIds", "profile", "tenant"],
          "properties": {
            "board": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
            "taskId": {"type": "string", "pattern": "^t_[a-f0-9]{8}$"},
            "workflowTaskIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^t_[a-f0-9]{8}$"}
            },
            "profile": {"type": "string", "minLength": 1},
            "tenant": {"type": "string", "minLength": 1}
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deliveryRepository", "evidenceIssues"],
          "properties": {
            "deliveryRepository": {"const": "frankxai/awesome-agent-operating-systems"},
            "evidenceIssues": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["repository", "number", "role", "url"],
                "properties": {
                  "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
                  "number": {"type": "integer", "minimum": 1},
                  "role": {"enum": ["promotion-gate", "runtime-defect", "delivery"]},
                  "url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[0-9]+$"}
                }
              }
            }
          }
        },
        "swarm": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["jobId", "ownerMachine", "role"],
              "properties": {
                "jobId": {"type": "string", "minLength": 1},
                "ownerMachine": {"enum": ["starlight-queen-yogabook", "starlight-queen-c940"]},
                "role": {"enum": ["fleet-routing", "peer-execution"]}
              }
            }
          ]
        },
        "paperclip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrationStatus", "issueId", "executionAuthority"],
          "properties": {
            "integrationStatus": {"enum": ["not-integrated", "evaluation-only", "approved"]},
            "issueId": {"type": ["string", "null"]},
            "executionAuthority": {"const": false}
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(docs|scripts|reports|data|tests)/[^\\\\]+$"
      }
    }
  }
}
